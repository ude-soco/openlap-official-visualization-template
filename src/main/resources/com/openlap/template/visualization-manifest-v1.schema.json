{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlap:visualization-manifest:1",
  "title": "OpenLAP visualization manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pluginId", "pluginVersion", "assets", "runtimes", "charts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "pluginId": {"$ref": "#/$defs/id"},
    "pluginVersion": {"type": "string", "minLength": 1, "maxLength": 100},
    "assets": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/asset"}},
    "runtimes": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/runtime"}},
    "charts": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/chart"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z][A-Za-z0-9._-]*$", "not": {"enum": ["constructor", "prototype", "__proto__"]}},
    "primitive": {"type": ["string", "number", "boolean"]},
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "kind", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "maxLength": 240, "pattern": "^web/[A-Za-z0-9_./-]+\\.(js|css|png|svg)$"},
        "kind": {"enum": ["script", "style", "image"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "assets"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "assets": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "chart": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "implementingClass", "runtimeId", "customizations"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "implementingClass": {"type": "string", "maxLength": 512, "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)+$"},
        "runtimeId": {"$ref": "#/$defs/id"},
        "description": {"type": "string", "maxLength": 10000},
        "iconAssetId": {"$ref": "#/$defs/id"},
        "inputRoles": {
          "type": "object", "additionalProperties": false,
          "properties": {"category": {"type": "string", "minLength": 1, "maxLength": 300}, "series": {"type": "string", "minLength": 1, "maxLength": 300}}
        },
        "customizations": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/customization"}}
      }
    },
    "customization": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "type", "group"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 300},
        "type": {"enum": ["text", "number", "boolean", "select", "color"]},
        "defaultValue": {"$ref": "#/$defs/primitive"},
        "options": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["value", "label"],
            "properties": {"value": {"$ref": "#/$defs/primitive"}, "label": {"type": "string", "minLength": 1, "maxLength": 300}}
          }
        },
        "min": {"type": "number"}, "max": {"type": "number"}, "step": {"type": "number", "exclusiveMinimum": 0},
        "help": {"type": "string", "maxLength": 2000},
        "group": {"enum": ["elements", "styles", "filters"]},
        "visibleWhen": {
          "type": "object", "additionalProperties": false, "required": ["id", "equals"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "equals": {"$ref": "#/$defs/primitive"}}
        }
      }
    }
  }
}
